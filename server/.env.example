# Server Environment Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/openorbit

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# GitHub Integration
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com

# AI Provider Configuration ('gemini' | 'ollama')
AI_PROVIDER=gemini

# Hosted Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest

# MCP Client (Optional)
MCP_ENABLED=false
MCP_SERVER_COMMAND=
MCP_SERVER_ARGS=[]

# GitHub App Authentication (Optional — leave blank to disable)
# Create a GitHub App at https://github.com/settings/apps
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# GitHub Token Encryption Key (Required when GitHub App auth is enabled)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_ENCRYPTION_KEY=
