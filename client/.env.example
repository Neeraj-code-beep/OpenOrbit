# ==============================================================================
# OpenOrbit Frontend Environment Template (client/.env.example)
# Copy to client/.env.local for local overrides.
# NOTE: Only variables prefixed with VITE_ are accessible in the browser.
# NEVER place secrets, tokens, or private API keys in this file.
# ==============================================================================

# Public Express API Base URL
# Leave empty to use the default Vite development proxy (/api -> http://localhost:5000)
# When set in production (e.g. https://api.openorbit.example.com), API requests target that base.
VITE_API_BASE_URL=
