# Python AI Service Environment Configuration Template
# Copy this file to .env and configure for local development

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5000", "http://localhost:5173", "http://127.0.0.1:5000"]

# Ollama / Local Model Settings (Offline AI Fallback)
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_LOCAL_MODEL=llama3:latest

# Google Gemini API Settings (Optional if calling Gemini directly from Python)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GitHub Integration (Optional token for higher rate limits)
GITHUB_TOKEN=

# Repository Context Processing Limits
MAX_CONTEXT_FILE_SIZE_KB=256
MAX_TOTAL_CONTEXT_TOKENS=32000
