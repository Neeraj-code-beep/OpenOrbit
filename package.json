{
  "name": "prpath",
  "version": "1.0.0",
  "description": "PRPath — AI-Powered Open Source Contribution Assistant",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "test": "npm --prefix server run test",
    "test:client": "npm --prefix client run lint"
  },
  "keywords": [
    "open-source",
    "github",
    "ai",
    "gemini",
    "gemma",
    "ollama",
    "mcp"
  ],
